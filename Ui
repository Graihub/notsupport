Title.TextSize = 32
Title.TextColor3 = Color3.fromRGB(255,170,60)

Title.FontFace = Font.new(
    "rbxasset://fonts/families/Oswald.json",
    Enum.FontWeight.Bold,
    Enum.FontStyle.Normal
)

local Line = Instance.new("Frame")
Line.Parent = Main
Line.Size = UDim2.new(0.8,0,0,2)
